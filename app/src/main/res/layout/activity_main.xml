<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FF1C1B1F">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#FF6750A4"
        app:title="SoftRouter"
        app:titleTextColor="#FFFFFFFF"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#FF2B2930"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shizuku_status"
                android:textColor="#FFCAC4D0"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvShizukuStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="检测中..."
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/router_status"
                android:textColor="#FFCAC4D0"
                android:textSize="14sp"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvRouterStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已停止"
                android:textColor="#FFFFB4AB"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_url"
                android:textColor="#FFCAC4D0"
                android:textSize="14sp"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvDashboardUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="http://0.0.0.0:8080"
                android:textColor="#FFD0BCFF"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="@string/start_router"
        android:textSize="16sp"
        app:cornerRadius="28dp"
        app:layout_constraintTop_toBottomOf="@id/statusCard" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenDashboard"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/open_dashboard"
        android:textSize="16sp"
        app:cornerRadius="28dp"
        app:strokeColor="#FF6750A4"
        app:layout_constraintTop_toBottomOf="@id/btnToggle" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilGateway"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="网关 IP (如 192.168.43.1)"
        app:boxStrokeColor="#FF6750A4"
        app:layout_constraintTop_toBottomOf="@id/btnOpenDashboard">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etGateway"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="192.168.43.1"
            android:textColor="#FFFFFFFF"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDhcpRange"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="DHCP 范围 (如 192.168.43.100-200)"
        app:boxStrokeColor="#FF6750A4"
        app:layout_constraintTop_toBottomOf="@id/tilGateway">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDhcpRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="192.168.43.100,192.168.43.200"
            android:textColor="#FFFFFFFF"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:background="#FF141218"
        app:layout_constraintTop_toBottomOf="@id/tilDhcpRange"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:textColor="#FFA8A0B0"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="等待操作...\n" />
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

</content>